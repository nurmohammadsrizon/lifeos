# Production Environment Configuration Template
# Copy to .env.production and fill in all values

# ============================================
# CRITICAL: These values must be set correctly
# for production deployment
# ============================================

# Application Environment
ENVIRONMENT=production
DEBUG=false

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Frontend & Domain
FRONTEND_URL=https://yourdomain.com
API_BASE_URL=https://yourdomain.com/api

# CORS - Set to your production domain only
BACKEND_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Use PostgreSQL in production, NOT SQLite

DATABASE_URL=postgresql://lifeos:STRONG_PASSWORD_HERE@db:5432/lifeos
DB_USER=lifeos
DB_PASSWORD=STRONG_PASSWORD_HERE
DB_NAME=lifeos

# Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ============================================
# SECURITY
# ============================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=GENERATE_A_STRONG_SECRET_KEY_HERE

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# HTTPS/SSL
FORCE_HTTPS=true
TRUSTED_PROXIES=*

# ============================================
# EMAIL CONFIGURATION
# ============================================

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
# Generate App Password from Google Account Settings
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

MAIL_FROM=noreply@yourdomain.com
MAIL_DISPLAY_NAME=LifeOS

# Contact email (where contact form emails are sent)
CONTACT_EMAIL_RECIPIENT=admin@yourdomain.com

# ============================================
# EXTERNAL API KEYS
# ============================================

# Google Gemini AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Sentry (Error Tracking) - Optional
SENTRY_DSN=

# ============================================
# REDIS CONFIGURATION
# ============================================

# For caching and sessions
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=STRONG_REDIS_PASSWORD_HERE

# ============================================
# FILE UPLOADS
# ============================================

MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,txt,csv
UPLOAD_DIRECTORY=uploads/files

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=10

# ============================================
# MONITORING & OBSERVABILITY
# ============================================

# Application Performance Monitoring
APM_ENABLED=false
APM_SERVICE_NAME=lifeos

# Error Tracking
ERROR_TRACKING_ENABLED=false
ERROR_TRACKING_ENVIRONMENT=production

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# ============================================
# FEATURE FLAGS
# ============================================

ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false

# ============================================
# PERFORMANCE
# ============================================

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# ============================================
# DEPLOYMENT
# ============================================

# Number of Gunicorn workers (CPU cores * 2 + 1)
GUNICORN_WORKERS=9

# Gunicorn worker class
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker

# ============================================
# BACKUP & MAINTENANCE
# ============================================

# Backup settings
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30

# Database Maintenance
VACUUM_ENABLED=true
VACUUM_SCHEDULE=0 3 * * *  # 3 AM daily
